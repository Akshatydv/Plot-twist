# Supabase — all server-side only. Do NOT prefix any of these with
# NEXT_PUBLIC_; none of them should ever reach the browser.
#
# Without SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY, submissions fall back to
# .data/applications.jsonl in development and are refused outright in
# production. Without SUPABASE_ANON_KEY, /admin/login can't authenticate
# anyone (it fails with a message, not a crash).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth only — this is the anon/public key from the same Supabase project.
# It cannot read the applications table (RLS blocks it); it can only prove
# who someone is. See src/lib/supabase/server.ts.
SUPABASE_ANON_KEY=

# Optional — defaults to "applications".
# SUPABASE_APPLICATIONS_TABLE=applications

# --------------------------------------------------------------------------
# Admin access — comma-separated emails, case-insensitive. Being a valid
# Supabase Auth user is not enough on its own; the email must be listed here
# too. See src/lib/adminAllowlist.ts.
# --------------------------------------------------------------------------
ADMIN_EMAILS=

# Public site origin. Used for canonical URLs, robots.txt and sitemap.xml.
# Safe to expose — it is just the domain.
NEXT_PUBLIC_SITE_URL=https://plotwist.in

# The tea cup contact number. Digits only, country code included, no "+" and
# no spaces (e.g. 919876543210). Public by design — it is printed on the page.
# Unset, the tea cup does not render at all.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --------------------------------------------------------------------------
# PHASE 4B — ADMIN NOTIFICATIONS (server-only, never NEXT_PUBLIC_)
#
# Fired by an AFTER INSERT trigger on the applications table, not by the
# browser. If any of this is unset the notification is skipped and logged —
# the application itself still saves normally.
# --------------------------------------------------------------------------

# Resend API key. Server-only: it is read in src/lib/notifications/email.ts,
# which imports `server-only`, so an accidental client import is a build error.
RESEND_API_KEY=

# Who gets the casting alert. Comma-separated for more than one recipient.
ADMIN_NOTIFICATION_EMAIL=

# The From address. Must be on a domain verified in Resend. Unset, it falls
# back to Resend's shared onboarding sender, which only delivers to the
# address that owns the Resend account — fine for a smoke test, not for live.
# NOTIFICATIONS_FROM_EMAIL=Plot Twist Casting <casting@plottwist.social>

# Shared secret between the database trigger and
# /api/internal/notifications/application. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The SAME value must also be stored in private.notification_config in
# Supabase — see README, Phase 4B.
NOTIFICATIONS_WEBHOOK_SECRET=

# Absolute URL the database trigger POSTs to. Supabase cannot reach localhost,
# so DB-triggered delivery only completes once this is a public origin.
# Re-run scripts/setup-notifications.mjs whenever this changes.
NOTIFICATIONS_WEBHOOK_URL=https://plottwist.social/api/internal/notifications/application

# Google Analytics 4 measurement ID. Public by design (it is embedded in
# every page's HTML by definition) — safe as NEXT_PUBLIC_. Unset, no GA
# script loads at all; the site works identically either way.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
